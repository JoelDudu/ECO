{
  "name": "eco-gateway",
  "version": "0.1.0",
  "description": "ECO — Ultra-lightweight WhatsApp Gateway & Listener powered by Baileys & TypeScript",
  "license": "AGPL-3.0",
  "author": "ECO Contributors",
  "homepage": "https://github.com/your-org/eco",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/eco.git"
  },
  "keywords": ["whatsapp", "baileys", "gateway", "webhook", "typescript", "multi-instance"],
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@scalar/express-api-reference": "^0.3.0",
    "@whiskeysockets/baileys": "^6.7.12",
    "better-sqlite3": "^9.6.0",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pino": "^9.1.0",
    "pino-pretty": "^11.2.1",
    "qrcode": "^1.5.3",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.22.0",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  }
}
