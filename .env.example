# ══════════════════════════════════════════════════════════════
# ECO — WhatsApp Gateway Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# ══════════════════════════════════════════════════════════════

# ── Servidor API ──────────────────────────────────────────────
PORT=3000

# ── Dashboard (EcoHub) ────────────────────────────────────────
# Porta exclusiva do painel visual (separada da API)
DASHBOARD_PORT=3001
DASHBOARD_ENABLED=true
# Senha de acesso ao painel (deixe vazio para desativar auth)
DASHBOARD_SECRET=

# ── Segurança ─────────────────────────────────────────────────
# Chave secreta obrigatória para todos os endpoints da API
# Enviar via header: x-api-key ou Authorization: Bearer <key>
API_KEY=change_me_to_a_strong_random_secret

# Chave de criptografia AES-256-GCM para proteger credenciais no banco
# DEVE ter exatamente 32 caracteres. Gere com: openssl rand -hex 16
# Se vazia, as sessões serão salvas sem criptografia (não recomendado em produção)
APP_ENCRYPTION_KEY=

# ── Persistência de Sessão ────────────────────────────────────
# Driver do banco de dados de sessões
# Opções: sqlite | postgres
DATABASE_DRIVER=sqlite

# URL de conexão com o banco
# SQLite (padrão, zero configuração): file:./eco.db
# PostgreSQL: postgresql://user:password@localhost:5432/eco
DATABASE_URL=file:./eco.db

# ── Mensageria & Filas (BullMQ) ───────────────────────────────
# Driver de fila para envio e webhooks
# Opções:
#   memory  → Zero dependências externas. Ideal para dev e testes locais.
#             Atenção: mensagens são perdidas ao reiniciar o servidor.
#   redis   → BullMQ + Redis. RECOMENDADO para produção.
#             Rate limiting anti-ban, retentativas automáticas e DLQ.
#             Suporta Upstash (gratuito), Redis Cloud ou instância local.
QUEUE_DRIVER=memory

# URL do Redis — necessário apenas se QUEUE_DRIVER=redis
# Upstash (grátis):   rediss://:<token>@<host>.upstash.io:6380
# Redis Cloud (grátis): redis://:<password>@<host>:<port>
# Local:              redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Anti-Ban & Rate Limiting ──────────────────────────────────
# Máximo de mensagens enviadas por janela de tempo
SEND_RATE_MAX=1
# Duração da janela de tempo em milissegundos (3000 = 3 segundos)
SEND_RATE_DURATION_MS=3000
# Delay mínimo aleatório entre envios em ms (simula comportamento humano)
SEND_MIN_DELAY_MS=500
# Delay máximo aleatório entre envios em ms
SEND_MAX_DELAY_MS=2000

# ── Log ───────────────────────────────────────────────────────
# Nível de log: debug | info | warn | error
LOG_LEVEL=info
# Formato: pretty (legível, dev) | json (produção / sistemas de log)
LOG_FORMAT=pretty
