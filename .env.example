# ══════════════════════════════════════════════════════════════
# ECO — WhatsApp Gateway Configuration
# Copie este arquivo para .env e preencha com seus valores
# NUNCA envie o arquivo .env para o GitHub ou controle de versão
# ══════════════════════════════════════════════════════════════

# ── Ambiente & Execução ───────────────────────────────────────
# development | production | test
NODE_ENV=production

# ── Servidor API ──────────────────────────────────────────────
# Porta da API REST principal
PORT=3000

# ── Dashboard (EcoHub) ────────────────────────────────────────
# Porta exclusiva do painel visual (separada da API)
DASHBOARD_PORT=3001
DASHBOARD_ENABLED=true
# Senha de acesso ao painel (deixe vazio para desativar autenticação)
DASHBOARD_SECRET=

# ── Segurança ─────────────────────────────────────────────────
# Chave secreta obrigatória para os endpoints da API (header: x-api-key)
API_KEY=change_me_to_a_strong_random_secret

# Chave de criptografia AES-256-GCM para proteger credenciais de sessão
# DEVE ter exatamente 32 caracteres. Gere com: openssl rand -hex 16
# Se vazia, as credenciais serão salvas sem criptografia (não recomendado em produção)
APP_ENCRYPTION_KEY=

# ── Persistência de Sessão ────────────────────────────────────
# Driver do banco de dados de sessões: sqlite | postgres
DATABASE_DRIVER=sqlite

# URL de conexão com o banco
# SQLite (padrão): file:./eco.db (as sessões ficam salvas na pasta ./sessions)
# PostgreSQL: postgresql://user:password@localhost:5432/eco
DATABASE_URL=file:./eco.db

# ── Mensageria & Filas (BullMQ + Redis) ───────────────────────
# Driver de fila para envio de mensagens e disparo de webhooks
# Opções:
#   memory → Sem dependências externas. Ideal para dev local (jobs perdidos ao reiniciar).
#   redis  → BullMQ conectado ao Redis. RECOMENDADO para produção no EasyPanel.
#            Garante retentativas com backoff, rate limiting anti-ban e DLQ auditável.
QUEUE_DRIVER=memory

# Conexão com Redis (Obrigatório se QUEUE_DRIVER=redis)
# - No EasyPanel (serviço Redis no mesmo projeto): redis://default:<senha>@<nome-do-servico>:6379
# - Upstash (gratuito / TLS):                      rediss://:<token>@<host>.upstash.io:6380
# - Redis Cloud:                                  redis://:<senha>@<host>:<porta>
# - Local (Docker/host):                          redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Anti-Ban & Rate Limiting ──────────────────────────────────
# Máximo de mensagens enviadas por janela de tempo
SEND_RATE_MAX=1
# Duração da janela de tempo em milissegundos (3000 = 3 segundos)
SEND_RATE_DURATION_MS=3000
# Delay mínimo aleatório entre envios em ms (simula comportamento humano)
SEND_MIN_DELAY_MS=500
# Delay máximo aleatório entre envios em ms
SEND_MAX_DELAY_MS=2000

# ── Log ───────────────────────────────────────────────────────
# Nível de log: debug | info | warn | error
LOG_LEVEL=info
# Formato: pretty (legível em dev) | json (produção / sistemas de log como EasyPanel)
LOG_FORMAT=pretty
